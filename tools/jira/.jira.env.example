# Kopieren nach tools/jira/.jira.env und ausfüllen (wird nicht eingecheckt).
JIRA_URL=https://firma.atlassian.net
# Nur bei Jira Cloud setzen – bei Server/Data Center leer lassen:
JIRA_EMAIL=ich@firma.de
# Cloud: API-Token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Server/DC: Personal Access Token (Profil → Personal Access Tokens)
JIRA_TOKEN=

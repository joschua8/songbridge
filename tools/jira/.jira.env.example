# Copy to tools/jira/.jira.env and fill in (that file is never committed).
JIRA_URL=https://company.atlassian.net
# Only for Jira Cloud – leave empty for Server/Data Center:
JIRA_EMAIL=me@company.com
# Cloud: API token (https://id.atlassian.com/manage-profile/security/api-tokens)
# Server/DC: Personal Access Token (Profile → Personal Access Tokens)
JIRA_TOKEN=
